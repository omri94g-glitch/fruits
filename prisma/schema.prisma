// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdminRole {
  ADMIN
  COURIER
}

model Product {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String
  images       String[]
  basePrice    Decimal   @db.Decimal(10, 2)
  category     String
  isBestSeller Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  occasionTags        String[]
  whatsIncluded       String[]
  dimensions          String?
  allergensInfo       String?
  kosherInfo          String?
  storageInstructions String?
  prepTimeHours       Int?
  badges              String[]

  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  price     Decimal @db.Decimal(10, 2)
  servesLabel String?

  orderItems OrderItem[]
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())

  // Opt-in to marketing messages (Israeli anti-spam law needs explicit prior
  // consent). Never set automatically - only from the unchecked-by-default
  // checkbox at checkout; the timestamp is the proof of when it was given.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  orders Order[]

  @@index([phone])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(PENDING)
  paymentProvider String?
  paymentRef      String?

  deliveryAddress  String
  deliveryCity     String
  deliveryDate     DateTime?
  deliveryTimeSlot String?
  cardMessage      String?

  courierId String?
  courier   AdminUser? @relation(fields: [courierId], references: [id])

  // totalAmount includes deliveryFee. Orders placed before delivery fees
  // existed keep 0 - they really weren't charged one.
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  // Coupon applied at checkout: the code is a snapshot (the Coupon row may be
  // edited/disabled later) and discountAmount is what was actually taken off
  // the items total. totalAmount = items - discountAmount + deliveryFee.
  couponCode     String?
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([status])
  @@index([customerId])
}

// Discount code. Either percentOff or amountOff is set. usedCount only goes up
// when a payment is confirmed, so abandoned checkouts don't burn a use.
model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique // stored lowercase, matched case-insensitively
  percentOff Int?
  amountOff  Decimal?  @db.Decimal(10, 2)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  maxUses    Int?
  minOrder   Decimal?  @db.Decimal(10, 2)
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  nameSnapshot String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  addOns       Json?
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedAt DateTime    @default(now())
  changedBy String

  @@index([orderId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())

  assignedOrders Order[]
}
